generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String             @id @default(cuid())
  githubId       Int                @unique
  email          String?
  name           String?
  avatarUrl      String?
  plan           String             @default("FREE")
  onboardingCompleted Boolean       @default(false)
  onboardingStep String?
  stripeCustomerId String?
  stripeSubscriptionId String?
  stripePriceId String?
  stripeCurrentPeriodEnd DateTime?
  account        GitHubAccount?
  installations  GitHubInstallation[]
  projects       Project[]
  chatSessions   ChatSession[]
  usageRecords   UsageRecord[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
}

model GitHubAccount {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubId             Int                @unique
  login                String
  name                 String?
  email                String?
  avatarUrl            String?
  accessToken          String?
  refreshToken         String?
  accessTokenExpiresAt DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model GitHubInstallation {
  id                  String         @id @default(cuid())
  githubId            Int            @unique
  accountId           Int
  accountLogin        String
  accountType         String         @default("User")
  repositorySelection String         @default("all")
  userId              String
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  repositories        Repository[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
}

model Repository {
  id             String               @id @default(cuid())
  githubId       Int                  @unique
  name           String
  owner          String
  fullName       String               @unique
  description    String?
  url            String
  language       String?
  visibility     String               @default("public")
  stars          Int                  @default(0)
  forks          Int                  @default(0)
  defaultBranch  String               @default("main")
  updatedAt      DateTime             @default(now())
  installationId String
  installation   GitHubInstallation   @relation(fields: [installationId], references: [id], onDelete: Cascade)
  project        Project?
  createdAt      DateTime             @default(now())
}

model Project {
  id           String       @id @default(cuid())
  name         String
  description  String?
  language     String?
  status       String       @default("QUEUED")
  repositoryId String       @unique
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  userId       String
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceFiles  SourceFile[]
  dependencies Dependency[]
  analyses     Analysis[]
  guides       OnboardingGuide[]
  architecture ArchitectureGraph[]
  codeIndex    CodeIndex?
  chatSessions ChatSession[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([userId])
  @@index([status])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model SourceFile {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  path       String
  name       String
  extension  String
  language   String?
  size       Int
  lineCount  Int
  hash       String
  directory  String
  createdAt  DateTime @default(now())

  @@unique([projectId, path])
  @@index([projectId, language])
}

model Dependency {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  version   String?
  type      String
  scope     String?
  createdAt DateTime @default(now())

  @@unique([projectId, type, name])
  @@index([projectId])
}

model Analysis {
  id           String             @id @default(cuid())
  projectId    String
  project      Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status       String             @default("QUEUED")
  step         String?
  error        String?
  commitSha    String?
  summary      Json?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  guides     OnboardingGuide[]
  architecture ArchitectureGraph[]

  @@index([projectId])
  @@index([status])
  @@index([projectId, status])
  @@index([commitSha])
}

model OnboardingGuide {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisId String?
  analysis   Analysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  commitSha  String?
  model      String?
  status     String       @default("GENERATING")
  step       String?
  error      String?
  content    Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
}

// Phase 5 — codebase Q&A (RAG).
//
// CodeIndex tracks the state of a project's semantic index. The vector column
// on FileChunk (vector(1024), added via prisma/vector-setup.sql) is never seen
// by Prisma — it is only read/written through raw SQL so `db push` stays safe.

model CodeIndex {
  id         String   @id @default(cuid())
  projectId  String   @unique
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status     String   @default("INDEXING") // INDEXING | COMPLETED | FAILED | EMPTY
  step       String?
  error      String?
  analysisId String?
  commitSha  String?
  chunkCount Int      @default(0)
  model      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([commitSha])
}

model FileChunk {
  id         String   @id @default(cuid())
  projectId  String
  fileId     String
  filePath   String
  chunkIndex Int
  content    String
  startLine  Int
  endLine    Int
  tokenCount Int?
  createdAt  DateTime @default(now())

  @@unique([projectId, fileId, chunkIndex])
  @@index([projectId])
  @@index([projectId, filePath])
}

model ChatSession {
  id        String        @id @default(cuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String?
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([projectId])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([projectId, updatedAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant"
  content   String
  sources   Json?
  createdAt DateTime    @default(now())

  @@index([sessionId])
}

// Phase 6 — architecture graph.
//
// ArchitectureGraph stores the evidence-based component/relationship model for
// one analyzed commit. Built deterministically from imports, routes, and
// dependencies — no AI — so it can be regenerated at any time.

model ArchitectureGraph {
  id         String       @id @default(cuid())
  projectId  String
  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisId String?
  analysis   Analysis?    @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  commitSha  String?
  status     String       @default("GENERATING") // GENERATING | COMPLETED | FAILED
  step       String?
  error      String?
  content    Json?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([projectId])
  @@index([status])
}

model UsageRecord {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStart     DateTime
  periodEnd       DateTime
  repositoriesAnalyzed Int   @default(0)
  aiQuestions     Int      @default(0)
  tokensConsumed  Int      @default(0)
  storageUsedBytes BigInt   @default(0)
  analysisRuns    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, periodStart])
  @@index([userId])
}